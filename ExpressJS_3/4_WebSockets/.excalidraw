    {
      "id": "kYAOGBl1ZpCHfZLkqGiJ_",
      "type": "text",
      "x": 1168.520935736915,
      "y": 781.2902854526915,
      "width": 1621.9373779296875,
      "height": 1852.6501847527607,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "au",
